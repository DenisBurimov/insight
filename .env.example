SECRET_KEY=your-secret-key

# Postgres connection string (used by Flask-Migrate and SQLAlchemy)
SQLALCHEMY_DATABASE_URI=postgresql://user:password@localhost:5432/insight

# Token checked by the payments sync scheduler endpoint
SCHEDULER_ACCESS_TOKEN=your-scheduler-token

# OpenAI API key for GPT-based query parsing and chat
OPENAI_API_KEY=your-openai-api-key

# Initial admin account created by `flask create-admin`
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Path to the Gmail OAuth2 token pickle file (generated via Google OAuth flow)
GMAIL_TOKEN_PATH=token.pickle
